    <!-- Onboarding -->
    <string name="onb1_title">Turn real objects into printable models</string>
    <string name="onb1_body">Walk around an object with your phone. %1$s builds a true-to-scale mesh you can send straight to your slicer or CAD.</string>
    <string name="onb1_privacy">Everything is processed on this phone. Nothing is uploaded.</string>
    <string name="onb2_title">For the best scan</string>
    <string name="tip_light_title">Bright, even light</string>
    <string name="tip_light_body">Daylight or a lit room. Avoid hard shadows.</string>
    <string name="tip_matte_title">Matte objects scan best</string>
    <string name="tip_matte_body">Shiny, clear or black parts may need scanning spray or a dusting of powder.</string>
    <string name="tip_slow_title">Move slowly</string>
    <string name="tip_slow_body">Smooth and steady. %1$s will tell you if you\'re too fast.</string>
    <string name="tip_around_title">Walk all the way around</string>
    <string name="tip_around_body">Fill the low, mid and high rings. Leave space around the object.</string>
    <string name="onb3_title">How a scan works</string>
    <string name="step1_title">Place the box</string>
    <string name="step1_body">Point at a table, tap the object, and drag the box to fit.</string>
    <string name="step2_title">Walk around</string>
    <string name="step2_body">A mesh builds over the object as the coverage rings fill in.</string>
    <string name="step3_title">Pick your result</string>
    <string name="step3_body">Quick is ready in seconds. High detail takes a few minutes for finer edges.</string>
    <string name="step4_title">Check scale and export</string>
    <string name="step4_body">Confirm size with a ruler or coin, then save STL or 3MF.</string>
    <string name="onb_get_started">Get started</string>
    <string name="onb_step_cd">Step %1$d of %2$d</string>

