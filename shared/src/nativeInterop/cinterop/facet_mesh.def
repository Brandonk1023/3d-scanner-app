# Kotlin/Native binding for the C++ core's C API (native/include/facet_mesh.h).
# The static library is built per Apple target by shared/build.gradle.kts (buildFacetCore* tasks)
# and embedded into the klib; -libraryPath is passed by Gradle.
headers = facet_mesh.h
package = app.facet.nativecore
staticLibraries = libfacet_core.a
linkerOpts = -lc++
